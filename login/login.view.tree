$bog_gipergram_login $mol_page
	tg $bog_gipergram_tg
	title @ \Log in
	mode? \qr
	body /
		<= Form $mol_list
			rows <= form_rows /
				<= Unconfigured $mol_paragraph
					title @ \Put api_id and api_hash from my.telegram.org into bog/gipergram/tg/tg.ts
				<= Qr $bog_qr
					uri <= qr_uri \
				<= Qr_wait $mol_paragraph
					title @ \Preparing the QR code…
				<= Qr_hint $mol_paragraph
					title @ \Open Telegram on your phone: Settings → Devices → Link Desktop Device, and point the camera at the code
				<= Phone_mode $mol_button_minor
					title @ \Log in by phone number
					click? <=> phone_mode? null
				<= Qr_mode $mol_button_minor
					title @ \Log in by QR code
					click? <=> qr_mode? null
				<= Phone $mol_string
					hint @ \Phone, +79991234567
					type \tel
					value? <=> phone? \
				<= Code_send $mol_button_major
					title @ \Get the code
					click? <=> code_send? null
				<= Code $mol_string
					hint @ \Code from Telegram
					value? <=> code? \
				<= Code_check $mol_button_major
					title @ \Log in
					click? <=> code_check? null
				<= Password $mol_string
					hint @ \Cloud password
					type \password
					value? <=> password? \
				<= Password_check $mol_button_major
					title @ \Log in
					click? <=> password_check? null
				<= Error $mol_paragraph
					title <= error \
