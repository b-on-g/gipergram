$bog_gipergram_devices $mol_page
	title @ \Devices
	tools /
		<= Close $mol_link
			arg *
				devices null
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Content $mol_list
			rows /
				<= Hint $mol_paragraph
					title @ \Tabs, unread marks and my messages sync through Giper Baza. To share them, scan the code or open the link on another device. The link is secret, it is the account key.
				<= Qr $bog_qr
					uri <= link \
				<= Copy $mol_button_copy
					text <= link
					title @ \Copy the link
				<= Import $mol_view
					sub /
						<= Input $mol_string
							hint @ \Link from another device
							value? <=> input? \
						<= Apply $mol_button_minor
							title @ \Apply
							click? <=> apply? null
				<= Status $mol_paragraph
					title <= status? \
	imported false
	status_wrong @ \This is not an account link
	status_same @ \This account is already here
