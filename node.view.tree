		aria-checked <= aria_checked \false
		role <= aria_role \checkbox
	sub /$mol_view_content
		<= Icon null
		<= label /
			<= Title $mol_view
				sub /
					<= title \

$mol_check_icon $mol_check

$bog_gipergram_message $mol_view
	attr *
		^
		bog_gipergram_message_out <= out false
	sub /
		<= Bubble $mol_view
			sub <= bubble_content /
				<= Author $mol_view
					sub /
						<= author \
				<= Text $mol_view
					sub /
						<= text \
				<= Time $mol_view
					sub /
						<= time \

