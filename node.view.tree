		0

$mol_icon_close $mol_icon path \M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z

$mol_page $mol_view
	dom_name \article
	attr *
		^
		tabIndex <= tabindex -1
	sub /
		<= Head $mol_view
			minimal_height 64
			dom_name \header
			sub <= head /
				<= Title $mol_view
					dom_name \h1
					sub <= title_content /
						<= Logo null
						<= title
				<= Tools $mol_view
					sub <= tools /$mol_view_content
		<= Body $mol_scroll
			scroll_top? => body_scroll_top?
			sub <= body_content /
				<= Body_content $mol_view
					sub <= body /$mol_view
		<= Foot $mol_view
			dom_name \footer
			sub <= foot /$mol_view

$mol_paragraph $mol_view
	line_height 24
	letter_width 7
	width_limit +Infinity
	row_width 0
	sub / <= title

$bog_qr $mol_svg_root
	uri \
	module_radius 0.35
	finder_radius 1.2
	gradient_angle 45
	error_correction \M
	quiet_zone 2
	center /
	gradient_id \qr-grad
	gradient_fill \url(#qr-grad)
	gradient_stops /
		\var(--mol_theme_special)
		\var(--mol_theme_focus)
	Stop* $mol_svg
		dom_name \stop
		attr *
			^
			offset <= stop_offset* \0%
			stop-color <= stop_color* \
	view_box <= qr_view_box \0 0 1 1
	sub /
		<= Defs $mol_svg
			dom_name \defs
			sub /
				<= Gradient $mol_svg
					dom_name \linearGradient
					attr *
						^
						id <= gradient_id
						x1 <= grad_x1 \0
						y1 <= grad_y1 \0
						x2 <= grad_x2 \1
						y2 <= grad_y2 \1
					sub <= gradient_stop_list /
		<= Modules $mol_svg_path
			geometry <= modules_d \
			attr *
				^
				fill <= gradient_fill
		<= Rings $mol_svg_path
			geometry <= rings_d \
			attr *
				^
				fill <= gradient_fill
				fill-rule \evenodd
		<= Centers $mol_svg_path
			geometry <= centers_d \
			attr *
				^
				fill <= gradient_fill
		<= Center_wrap $mol_svg
			dom_name \foreignObject
			attr *
				^
				x <= center_x \0
				y <= center_y \0
				width <= center_size \0
				height <= center_size
			sub /
				<= Center_body $mol_view
					sub <= center

$mol_hotkey2 $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	action *

$mol_hotkey $mol_hotkey2
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$bog_gipergram_login $mol_page
	tg $bog_gipergram_tg
	title @ \Log in
	mode? \qr
	body /
		<= Form $mol_list
			rows <= form_rows /
				<= Unconfigured $mol_paragraph
					title @ \Put api_id and api_hash from my.telegram.org into bog/gipergram/tg/tg.ts
				<= Qr $bog_qr
					uri <= qr_uri \
				<= Qr_wait $mol_paragraph
					title @ \Preparing the QR code…
				<= Qr_hint $mol_paragraph
					title @ \Open Telegram on your phone: Settings → Devices → Link Desktop Device, and point the camera at the code
				<= Phone_mode $mol_button_minor
					title @ \Log in by phone number
					click? <=> phone_mode? null
				<= Qr_mode $mol_button_minor
					title @ \Log in by QR code
					click? <=> qr_mode? null
				<= Phone $mol_string
					hint @ \Phone, +79991234567
					type \tel
					value? <=> phone? \
				<= Code_send $mol_button_major
					title @ \Get the code
					click? <=> code_send? null
				<= Code $mol_string
					hint @ \Code from Telegram
					value? <=> code? \
				<= Code_check $mol_button_major
					title @ \Log in
					click? <=> code_check? null
				<= Password $mol_string
					hint @ \Cloud password
					type \password
					value? <=> password? \
				<= Password_check $mol_button_major
					title @ \Log in
					click? <=> password_check? null
				<= Error $mol_paragraph
					title <= error \

