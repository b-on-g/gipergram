$mol_icon_undo $mol_icon path \M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z

$mol_stack $mol_view

$mol_dimmer $mol_paragraph
	haystack \
	needle \
	sub <= parts /$mol_view_content
	Low* $mol_paragraph
		sub /
			<= string* \
	High* $mol_paragraph
		sub /
			<= string* \

$mol_text_code_token $mol_dimmer
	attr *
		^
		mol_text_code_token_type <= type \

$mol_text_code_token_link $mol_text_code_token
	dom_name \a
	type \code-link
	attr *
		^
		href <= uri \
		target \_blank

$mol_text_code_line $mol_paragraph
	text \
	minimal_height 24
	numb_showed true
	syntax null
	uri_resolve* \
	Numb $mol_view
		sub /
			<= numb 0
	Token* $mol_text_code_token
		type <= token_type* \
		haystack <= token_text* \
		needle <= highlight \
	Token_link* $mol_text_code_token_link
		haystack <= token_text* \
		needle <= highlight \
		uri <= token_uri* \
	find_pos* null

$mol_text_code $mol_stack
	attr *
		^
		mol_text_code_sidebar_showed <= sidebar_showed false
	text \
	text_lines /string
	find_pos* null
	uri_base \
	row_themes /string
	sub /
		<= Rows $mol_list
			render_visible_only <= render_visible_only false
			rows <= rows /
				<= Row*0 $mol_text_code_line
					numb_showed <= sidebar_showed
					numb <= row_numb* 0
					theme <= row_theme* \
					text <= row_text* \
					syntax <= syntax null
					uri_resolve* <= uri_resolve* \
					highlight <= highlight \
		<= Copy $mol_button_copy
			hint @ \Copy whole code
			text <= text_export \

$mol_textarea $mol_stack
	attr *
		^
		mol_textarea_clickable <= clickable? false
		mol_textarea_sidebar_showed <= sidebar_showed false
	event *
		keydown? <=> press? null
		pointermove? <=> hover? null
	sub /
		<= Edit $mol_textarea_edit
			value? <=> value? \
			hint <= hint \ 
			enabled <= enabled true
			spellcheck <= spellcheck true
			length_max <= length_max +Infinity
			selection? <=> selection? /number
			bring => bring
			submit? <=> submit? null
			submit_with_ctrl <= submit_with_ctrl true
		<= View $mol_text_code
			text <= value
			render_visible_only false
			row_numb* <= row_numb* 0
			sidebar_showed <= sidebar_showed
			highlight <= highlight \
			syntax <= syntax $mol_syntax2
	symbols_alt *string
		comma \<
		period \>
		dash \−
		equals \≈
		graveAccent \́
		forwardSlash \÷
		E \€
		V \✔
		X \×
		C \©
		P \§
		H \₽
		key0 \°
		key8 \•
		key2 \@
		key3 \#
		key4 \$
		key6 \^
		key7 \&
		bracketOpen \[
		bracketClose \]
		slashBack \|
	symbols_alt_ctrl *string
		space \ 
	symbols_alt_shift *string
		V \✅
		X \❌
		O \⭕
		key1 \❗
		key4 \💲
		key7 \❓
		comma \«
		period \»
		semicolon \“
		quoteSingle \”
		dash \—
		equals \≠
		graveAccent \̱
		bracketOpen \{
		bracketClose \}

$mol_textarea_edit $mol_string
	dom_name \textarea
	enter \enter
	field *
		^
		scrollTop 0

$mol_icon_send $mol_icon path \M2,21L23,12L2,3V10L17,12L2,14V21Z

$bog_gipergram_chat $mol_page
	peer \
	tg $bog_gipergram_tg
	store $bog_gipergram_store
	title <= chat_title \
	tools /
		<= Bump $mol_button_minor
			hint @ \Поднять вкладку наверх
			click? <=> bump? null
			sub /
				<= Bump_icon $mol_icon_arrow_up
		<= Split $mol_check_icon
			hint @ \Держать открытым рядом
			checked? <=> split? false
			Icon <= Split_icon $mol_icon_view_split_vertical
		<= Close $mol_button_minor
			hint @ \Закрыть вкладку
			click? <=> close? null
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Messages $mol_list
			rows <= message_rows /
				<= Unread $mol_view
					sub /
						<= unread_title @ \Новые с прошлого раза
				<= Message* $bog_gipergram_message
					text <= message_text* \
					author <= message_author* \
					time <= message_time* \
					out <= message_out* false
	unread_count 0
	unread_count_label @ \непрочитано
	foot /
		<= Anchor_bar $mol_view
			sub <= anchor_bar /
				<= Unread_count $mol_view
					sub /
						<= unread_count_text \
				<= Read $mol_button_minor
					hint @ \Отметить всё прочитанным
					click? <=> read? null
					sub /
						<= Read_icon $mol_icon_check_all
				<= Restore $mol_button_minor
					hint @ \Вернуть прошлую отметку
					click? <=> restore? null
					sub /
						<= Restore_icon $mol_icon_undo
		<= Compose $mol_view
			sub /
				<= Draft $mol_textarea
					hint @ \Сообщение, Ctrl+Enter
					value? <=> draft? \
					submit? <=> send? null
				<= Send $mol_button_major
					hint @ \Отправить
					click? <=> send? null
					sub /
						<= Send_icon $mol_icon_send

$bog_gipergram_app $mol_book2
	plugins /
		<= Theme $bog_theme_auto
	tg $bog_gipergram_tg
		message_out? <=> message_out? null
	store $bog_gipergram_store
	Login $bog_gipergram_login
		tg <= tg
	Devices $bog_gipergram_devices
	Menu $mol_page
		title \Gipergram
		tools /
			<= Mine_link $mol_link
				hint @ \Мои сообщения
				arg *
					mine \
				sub /
					<= Mine_icon $mol_icon_comment_account
			<= Devices_link $mol_link
				hint @ \Устройства и синхронизация
				arg *
					devices \
				sub /
					<= Devices_icon $mol_icon_cellphone_link
			<= Logout $mol_button_minor
				hint @ \Выйти
				click? <=> logout? null
				sub /
					<= Logout_icon $mol_icon_logout
		body /
			<= Tabs_title $mol_view
				sub /
					<= tabs_title @ \Вкладки
			<= Tabs $mol_list
				rows <= tab_rows /
					<= Tab* $bog_gipergram_row
						peer <= row_peer* \
						title <= row_title* \
						preview <= row_preview* \
						time <= row_time* \
						unread <= tab_unread* 0
						arg <= row_arg* *
						click? <=> chat_open*? null
			<= Chats_title $mol_view
				sub /
					<= chats_title @ \Все чаты
			<= Chats $mol_list
				rows <= chat_rows /
					<= Chat_row* $bog_gipergram_row
						peer <= row_peer* \
						title <= row_title* \
						preview <= row_preview* \
						time <= row_time* \
						unread <= chat_unread* 0
						arg <= row_arg* *
						click? <=> chat_open*? null
	Chat* $bog_gipergram_chat
		peer <= chat_peer* \
		tg <= tg
		store <= store
	Mine $mol_page
		title @ \Мои сообщения
		tools /
			<= Mine_close $mol_link
				arg *
					mine null
				sub /
					<= Mine_close_icon $mol_icon_close
		body /
			<= Mine_list $mol_list
				rows <= mine_rows /
					<= Mine_row* $bog_gipergram_row
						peer <= mine_peer* \
						title <= mine_title* \
						preview <= mine_text* \
						time <= mine_time* \
						arg <= mine_arg* *
						click? <=> chat_open*? null
