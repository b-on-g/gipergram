	find_pos* null

$mol_text_code $mol_stack
	attr *
		^
		mol_text_code_sidebar_showed <= sidebar_showed false
	text \
	text_lines /string
	find_pos* null
	uri_base \
	row_themes /string
	sub /
		<= Rows $mol_list
			render_visible_only <= render_visible_only false
			rows <= rows /
				<= Row*0 $mol_text_code_line
					numb_showed <= sidebar_showed
					numb <= row_numb* 0
					theme <= row_theme* \
					text <= row_text* \
					syntax <= syntax null
					uri_resolve* <= uri_resolve* \
					highlight <= highlight \
		<= Copy $mol_button_copy
			hint @ \Copy whole code
			text <= text_export \

$mol_textarea $mol_stack
	attr *
		^
		mol_textarea_clickable <= clickable? false
		mol_textarea_sidebar_showed <= sidebar_showed false
	event *
		keydown? <=> press? null
		pointermove? <=> hover? null
	sub /
		<= Edit $mol_textarea_edit
			value? <=> value? \
			hint <= hint \ 
			enabled <= enabled true
			spellcheck <= spellcheck true
			length_max <= length_max +Infinity
			selection? <=> selection? /number
			bring => bring
			submit? <=> submit? null
			submit_with_ctrl <= submit_with_ctrl true
		<= View $mol_text_code
			text <= value
			render_visible_only false
			row_numb* <= row_numb* 0
			sidebar_showed <= sidebar_showed
			highlight <= highlight \
			syntax <= syntax $mol_syntax2
	symbols_alt *string
		comma \<
		period \>
		dash \−
		equals \≈
		graveAccent \́
		forwardSlash \÷
		E \€
		V \✔
		X \×
		C \©
		P \§
		H \₽
		key0 \°
		key8 \•
		key2 \@
		key3 \#
		key4 \$
		key6 \^
		key7 \&
		bracketOpen \[
		bracketClose \]
		slashBack \|
	symbols_alt_ctrl *string
		space \ 
	symbols_alt_shift *string
		V \✅
		X \❌
		O \⭕
		key1 \❗
		key4 \💲
		key7 \❓
		comma \«
		period \»
		semicolon \“
		quoteSingle \”
		dash \—
		equals \≠
		graveAccent \̱
		bracketOpen \{
		bracketClose \}

$mol_textarea_edit $mol_string
	dom_name \textarea
	enter \enter
	field *
		^
		scrollTop 0

$bog_gipergram_chat $mol_page
	peer \
	tg $bog_gipergram_tg
	store $bog_gipergram_store
	recorder $bog_gipergram_voice
	voice_hint_stop @ \Send the voice message
	title <= chat_title \
	tools /
		<= Bump $mol_button_minor
			hint @ \Lift the tab to the top
			click? <=> bump? null
			sub /
				<= Bump_icon $mol_icon_arrow_up
		<= Split $mol_check_icon
			hint @ \Keep open side by side
			checked? <=> split? false
			Icon <= Split_icon $mol_icon_view_split_vertical
		<= Close $mol_button_minor
			hint @ \Close the tab
			click? <=> close? null
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Messages $mol_list
			rows <= message_rows /
				<= Unread $mol_view
					sub /
						<= unread_title @ \New since last time
				<= Message* $bog_gipergram_message
					text <= message_text* \
					author <= message_author* \
					time <= message_time* \
					out <= message_out* false
					media <= message_media* \
					image_uri <= message_image_uri* \
					image_width <= message_width* 0
					image_height <= message_height* 0
					voice_uri <= message_voice_uri* \
	unread_count 0
	unread_count_label @ \unread
	foot /
		<= Anchor_bar $mol_view
			sub <= anchor_bar /
				<= Unread_count $mol_view
					sub /
						<= unread_count_text \
				<= Read $mol_button_minor
					hint @ \Mark all as read
					click? <=> read? null
					sub /
						<= Read_icon $mol_icon_check_all
				<= Restore $mol_button_minor
					hint @ \Restore the previous mark
					click? <=> restore? null
					sub /
						<= Restore_icon $mol_icon_undo
		<= Compose $mol_view
			sub <= compose /
				<= Attach $mol_button_open
					hint @ \Send a picture
					accept \image/*
					multiple false
					files? <=> photo_pick? /File
					Icon <= Attach_icon $mol_icon_paperclip
				<= Recording $mol_view
					sub /
						<= recording_title @ \● Recording…
				<= Voice_cancel $mol_button_minor
					hint @ \Cancel recording
					click? <=> voice_cancel? null
					sub /
						<= Voice_cancel_icon $mol_icon_close
				<= Voice $mol_button_minor
					hint <= voice_hint @ \Record a voice message
					click? <=> voice_toggle? null
					sub <= voice_content /
						<= Voice_start_icon $mol_icon_microphone
						<= Voice_stop_icon $mol_icon_send
				<= Draft $mol_textarea
					hint @ \Message, Ctrl+Enter
					value? <=> draft? \
					submit? <=> send? null
				<= Send $mol_button_major
					hint @ \Send
					click? <=> send? null
					sub /
						<= Send_icon $mol_icon_send

$bog_gipergram_app $mol_book2
	plugins /
		<= Theme $bog_theme_auto
		<= Favicon $bog_favicon
			Icon <= Favicon_icon $mol_icon_send
	tg $bog_gipergram_tg
		message_out? <=> message_out? null
	store $bog_gipergram_store
	Login $bog_gipergram_login
		tg <= tg
	Devices $bog_gipergram_devices
	Menu $mol_page
		title \Gipergram
		tools /
			<= Mine_link $mol_link
				hint @ \My messages
				arg *
					mine \
				sub /
					<= Mine_icon $mol_icon_comment_account
			<= Devices_link $mol_link
				hint @ \Devices and sync
				arg *
					devices \
				sub /
					<= Devices_icon $mol_icon_cellphone_link
			<= Logout $mol_button_minor
				hint @ \Log out
				click? <=> logout? null
				sub /
					<= Logout_icon $mol_icon_logout
		body /
			<= Tabs_title $mol_view
				sub /
					<= tabs_title @ \Tabs
			<= Tabs $mol_list
				rows <= tab_rows /
					<= Tab* $bog_gipergram_row
						peer <= row_peer* \
						title <= row_title* \
						preview <= row_preview* \
						time <= row_time* \
						unread <= tab_unread* 0
						arg <= row_arg* *
						click? <=> chat_open*? null
			<= Chats_title $mol_view
				sub /
					<= chats_title @ \All chats
			<= Chats $mol_list
				rows <= chat_rows /
					<= Chat_row* $bog_gipergram_row
						peer <= row_peer* \
						title <= row_title* \
						preview <= row_preview* \
						time <= row_time* \
						unread <= chat_unread* 0
						arg <= row_arg* *
						click? <=> chat_open*? null
	Chat* $bog_gipergram_chat
		peer <= chat_peer* \
		tg <= tg
		store <= store
	Mine $mol_page
		title @ \My messages
		tools /
			<= Mine_close $mol_link
				arg *
					mine null
				sub /
					<= Mine_close_icon $mol_icon_close
		body /
			<= Mine_list $mol_list
				rows <= mine_rows /
					<= Mine_row* $bog_gipergram_row
						peer <= mine_peer* \
						title <= mine_title* \
						preview <= mine_text* \
						time <= mine_time* \
						arg <= mine_arg* *
						click? <=> chat_open*? null
