$bog_gipergram_message $mol_view
	media \
	attr *
		^
		bog_gipergram_message_out <= out false
	sub /
		<= Bubble $mol_view
			sub <= bubble_content /
				<= Author $mol_view
					sub /
						<= author \
				<= Image $mol_image
					uri <= image_uri \
					natural_width <= image_width 0
					natural_height <= image_height 0
				<= Voice $mol_view
					dom_name \audio
					attr *
						controls true
						preload \metadata
						src <= voice_uri \
				<= File $mol_view
					sub /
						<= file_title @ \📎 File
				<= Text $mol_view
					sub /
						<= text \
				<= Time $mol_view
					sub /
						<= time \
